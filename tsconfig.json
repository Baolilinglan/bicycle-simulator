{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true, "noEmit": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests/**/*.ts"]
}
