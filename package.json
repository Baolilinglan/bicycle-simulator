{
  "name": "manual-bicycle-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/physics.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "model:optimize": "gltf-transform optimize assets/rider/rider.raw.glb public/models/rider.glb --compress meshopt --flatten false --join false --simplify false --palette false",
    "model:validate": "gltf-transform validate public/models/rider.glb",
    "test:production": "node tests/production.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
